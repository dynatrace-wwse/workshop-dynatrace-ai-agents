{
  "name": "Dynatrace AI Agent Workshop",
  // Framework image (AMD64 + ARM64): kubectl, helm, k3d, node, python, gh preinstalled.
  "image": "shinojosa/dt-enablement:v1.4.0",
  // When running locally we pass the 'secrets' as env variables via runArgs "--env-file",".devcontainer/.env"
  "runArgs": ["--init", "--privileged", "--network=host"],
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"],
  // Entrypoint and CMD are overwritten by VSCode
  "overrideCommand": false,

  "remoteUser": "vscode",

  "postCreateCommand": "./.devcontainer/post-create.sh",

  "postStartCommand": "./.devcontainer/post-start.sh",

  "features": {},
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": []
    }
  },
  // Apps (kagent UI, Phoenix) are exposed through the framework ingress on :80
  // and listed by `listApps` — no NodePorts, no per-app port forwards.
  "forwardPorts": [80],
  "portsAttributes": {
    "80": { "label": "Apps (kagent UI, Phoenix)" }
  },
  // Measured on a full run (platform + 7 agents + offline LLM): see the
  // sizing section of the training README. 4 cores / 16 GB is the floor.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  // Codespaces prompts for these; Orbital injects the DT_* ones per learner.
  "secrets": {
    "DT_ENVIRONMENT": {
      "description": "Dynatrace platform URL, e.g. https://abc12345.apps.dynatrace.com"
    },
    "DT_OPERATOR_TOKEN": {
      "description": "Dynatrace Operator token (Kubernetes monitoring): activeGateTokenManagement.create/write, entities.read, settings.read/write, DataExport, InstallerDownload"
    },
    "DT_INGEST_TOKEN": {
      "description": "Dynatrace ingest token for agent telemetry (OTLP): openTelemetryTrace.ingest, metrics.ingest, logs.ingest, events.ingest"
    },
    "DT_PLATFORM_TOKEN": {
      "description": "Dynatrace platform token (dt0s16) for the Dynatrace MCP server and dtctl"
    },
    "DEEPSEEK_API_KEY": {
      "description": "Optional. DeepSeek API key for the agents. Without it the agents use a small in-cluster Ollama model."
    },
    "GH_PAT": {
      "description": "Optional. Fine-grained GitHub PAT scoped to one demo repo (Contents/Issues/PRs RW) for the BMAD crew."
    }
  }
}
